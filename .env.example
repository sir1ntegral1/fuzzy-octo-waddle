# Rabbit chat integration - copy to .env and fill in.
# .env is git-ignored; never commit real credentials.

# Base URL of the Rabbit chat API (no trailing slash).
# The scripts call <RABBIT_CHAT_URL>/messages and <RABBIT_CHAT_URL>/health.
RABBIT_CHAT_URL=

# Bearer token sent as `Authorization: Bearer <key>`. Leave empty for
# unauthenticated local endpoints.
RABBIT_API_KEY=

# Default channel/room for send and listen.
RABBIT_CHANNEL=general

# Identity messages are attributed to (also sent as the X-Rabbit-Agent header).
RABBIT_AGENT_ID=rabbit

# Per-request timeout in seconds.
RABBIT_TIMEOUT=30

# Attempts per request; 1 disables retries. Backoff is 1s, 2s, 4s...
RABBIT_RETRIES=3

# debug | info | warn | error
RABBIT_LOG_LEVEL=info

# Where listen cursors are stored (default: <repo>/.rabbit).
# RABBIT_STATE_DIR=

# Set to 1 to skip TLS verification. Local development only.
RABBIT_INSECURE=0
